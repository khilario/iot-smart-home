    {
        "id": "0f462423f6032931",
        "type": "function",
        "z": "243dca7834ad8931",
        "name": "",
        "func": "//complete the code\nconst devices = {\n    \"room1\": { power: 10, color: \"#0000FF\" },// Blue\n    \"room2\": { power: 10, color: \"#00FF00\"},       // Green\n    \"livingroom\": { power: 20, color: \"#000000\"}, // White\n    \"garage\": { power: 5, color: \"#FF0000\"}        // Red\n};\n\n\nlet currentStats = flow.get(\"energyStats\") || {};\n\nlet nodeName = msg.payload.node;\nlet status = msg.payload.status === \"on\" ? 1 : 0;\n\nif (nodeName && devices[nodeName]) {\n    currentStats[nodeName] = status * devices[nodeName].power;\n}\nflow.set(\"energyStats\", currentStats);\n\n\nlet labels = Object.keys(currentStats);\nlet data = Object.values(currentStats);\nlet colors = labels.map(label => devices[label].color);\n\n\nlet totalWatts = data.reduce((a, b) => a + b, 0);\n\n\nreturn [\n    { \n        payload: [{ \"series\": [\"Watts\"], \"data\": data, \"labels\": labels }],\n        colors: colors \n    },\n    { payload: totalWatts + \" W\" }\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\n//not needed",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 800,
        "wires": [
